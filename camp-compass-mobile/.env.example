# Mobile App Environment Configuration
# =====================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git (it's in .gitignore)

# -------------------------------------------------------
# LOCAL DEVELOPMENT (phone must be on same WiFi as PC)
# -------------------------------------------------------
# Find your PC IP: run ipconfig (Windows) or ifconfig (Mac)
# Replace 192.168.x.x with your actual PC IP address
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:3001
# EXPO_PUBLIC_APP_ENV=development

# -------------------------------------------------------
# PRODUCTION (works anywhere, any network, any phone)
# -------------------------------------------------------
# Replace with your actual deployed Vercel URL
EXPO_PUBLIC_API_BASE_URL=https://camp-compass-backend.vercel.app
EXPO_PUBLIC_APP_ENV=production
